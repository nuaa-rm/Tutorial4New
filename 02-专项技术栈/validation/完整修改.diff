-我们利用torch.save()函数将模型保存下来后，可以在其他地方加载模型，继续训练或者是直接使用。
+
+\begin{example}
+完整参考实现：保存为 lenet\_complete.py，运行 python lenet\_complete.py。首次运行会下载 MNIST；应逐轮输出 0 到 1 之间的验证准确率，最后输出测试准确率并保存参数。具体成绩与设备、版本有关。
+\begin{tpython}
+import torch
+from torch import nn
+from torchvision import datasets, transforms
+from torch.utils.data import DataLoader, random_split
+
+torch.manual_seed(42)
+class LeNet(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.layers = nn.Sequential(
+            nn.Conv2d(1,6,5), nn.ReLU(), nn.MaxPool2d(2),
+            nn.Conv2d(6,16,5), nn.ReLU(), nn.MaxPool2d(2),
+            nn.Flatten(), nn.Linear(256,120), nn.ReLU(),
+            nn.Linear(120,84), nn.ReLU(), nn.Linear(84,10))
+    def forward(self,x): return self.layers(x)
+
+if __name__ == "__main__":
+    transform = transforms.Compose([transforms.ToTensor(),
+        transforms.Normalize((0.1307,), (0.3081,))])
+    dataset = datasets.MNIST("data",train=True,download=True,transform=transform)
+    train_set, valid_set = random_split(dataset,[55000,5000])
+    train_loader = DataLoader(train_set,batch_size=64,shuffle=True,num_workers=0)
+    valid_loader = DataLoader(valid_set,batch_size=256,num_workers=0)
+    test_set = datasets.MNIST("data",train=False,download=True,transform=transform)
+    test_loader = DataLoader(test_set,batch_size=256,num_workers=0)
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    net = LeNet().to(device)
+    criterion = nn.CrossEntropyLoss()
+    optimizer = torch.optim.Adam(net.parameters(),lr=0.001)
+    def accuracy(loader):
+        net.eval()
+        correct = total = 0
+        with torch.no_grad():
+            for x,y in loader:
+                x,y=x.to(device),y.to(device)
+                correct += (net(x).argmax(1)==y).sum().item()
+                total += len(y)
+        return correct/total
+    for epoch in range(3):
+        net.train()
+        for x,y in train_loader:
+            x,y=x.to(device),y.to(device)
+            optimizer.zero_grad()
+            loss=criterion(net(x),y)
+            loss.backward()
+            optimizer.step()
+        print(epoch+1, "验证准确率", accuracy(valid_loader))
+    print("测试准确率",accuracy(test_loader))
+    torch.save(net.cpu().state_dict(),"lenet_complete.pth")
+\end{tpython}
+\end{example}
