Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 40; 50
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 10
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/Pose
      Name: Target pose
      Enabled: true
      Topic:
        Value: /viz/pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 10
      Shape: Arrow
      Shaft Length: 0.5
      Shaft Radius: 0.02
      Head Length: 0.15
      Head Radius: 0.05
    - Class: rviz_default_plugins/MarkerArray
      Name: Target graphics
      Enabled: true
      Topic:
        Value: /viz/markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 10
    - Class: rviz_default_plugins/Path
      Name: History
      Enabled: true
      Topic:
        Value: /viz/path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 10
      Line Style: Lines
      Color: 255; 180; 30
      Buffer Length: 1
    - Class: rviz_default_plugins/Image
      Name: Raw image
      Enabled: true
      Topic:
        Value: /viz/image
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 10
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Focal Point:
        X: 0
        Y: 0
        Z: 0.3
      Pitch: 0.65
      Yaw: 0.8
Window Geometry:
  Width: 1400
  Height: 950
