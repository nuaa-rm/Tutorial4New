<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>robot_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <!-- 换成当前机器所选网卡的 IPv4 地址。 -->
        <address>192.168.10.20</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="robot" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>robot_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
